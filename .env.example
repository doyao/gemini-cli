# Gemini CLI 自定义端点配置示例
# 复制此文件为 .env 并修改相应的值

# =====================================
# AI 服务端点配置
# =====================================

# Code Assist API 端点 (主要的AI服务端点)
CODE_ASSIST_ENDPOINT=https://your-backend-service.com

# 自定义 Gemini API 端点
GEMINI_API_ENDPOINT=https://your-backend-service.com

# 自定义 Vertex AI 端点  
VERTEX_AI_ENDPOINT=https://your-backend-service.com

# =====================================
# 认证配置
# =====================================

# Gemini API Key (如果使用API Key认证)
GEMINI_API_KEY=your-api-key-here

# Google API Key (用于Vertex AI)
GOOGLE_API_KEY=your-google-api-key

# Google Cloud 项目配置 (用于Vertex AI)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# =====================================
# 调试和开发配置
# =====================================

# 开启调试模式
DEBUG=1

# 沙箱配置
GEMINI_SANDBOX=false

# 自定义模型
GEMINI_MODEL=gemini-2.5-pro

# =====================================
# 高级配置
# =====================================

# 代理设置 (如果需要)
HTTP_PROXY=http://proxy.company.com:8080
HTTPS_PROXY=https://proxy.company.com:8080

# 遥测配置
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =====================================
# 使用说明
# =====================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 修改上面的配置值
# 3. 重启 Gemini CLI: npm run start
# 4. 验证配置: npm run debug